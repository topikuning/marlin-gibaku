# ── Wajib ────────────────────────────────────────────────────
APP_ENV=development                # development | test | production
DATABASE_URL=postgresql://marlin:marlin@localhost:5432/marlin_dev
SESSION_SECRET=                    # min 32 karakter acak: openssl rand -hex 32

# ── Cloudflare R2 (opsional — fitur upload nonaktif bila kosong) ──
# Endpoint S3: https://<accountid>.r2.cloudflarestorage.com (BUKAN r2.dev / custom domain)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── AI Intelligence Hub (opsional — fitur AI) ──
# Kunci enkripsi API key provider AI di database (AES-256-GCM).
# WAJIB di production bila fitur AI dipakai: openssl rand -hex 32
AI_SECRET_ENCRYPTION_KEY=

# Alamat publik MARLIN (skema + domain, tanpa garis miring di akhir).
# WAJIB bila OAuth Google Drive dipakai dan platform tidak mengirim
# x-forwarded-host (mis. host header berisi 0.0.0.0:8080).
# Di Railway biasanya cukup RAILWAY_PUBLIC_DOMAIN yang sudah otomatis ada.
APP_PUBLIC_URL=

# Cuaca laporan harian (opsional). Kosong = Open-Meteo publik, tanpa API key.
# Isi hanya bila memakai mirror/langganan berbayar dengan bentuk respons sama.
WEATHER_API_URL=
