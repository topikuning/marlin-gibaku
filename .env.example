# ── Wajib ────────────────────────────────────────────────────
APP_ENV=development                # development | test | production
DATABASE_URL=postgresql://marlin:marlin@localhost:5432/marlin_dev
SESSION_SECRET=                    # min 32 karakter acak: openssl rand -hex 32

# ── Super admin UTAMA (sangat disarankan diisi) ──────────────
# USERNAME (bukan email/ID) super admin pemilik sistem. Boleh lebih dari satu,
# dipisah koma. Di Railway: isi sebagai Variable, bukan di berkas.
#
# Kenapa perlu: tanpa ini akun super admin adalah PINTU SATU ARAH — super admin
# boleh MEMBUAT super admin lain, tapi tidak seorang pun bisa menonaktifkan,
# menurunkan, atau mereset akun setingkat. Orang keluar dari perusahaan dan
# akunnya tidak bisa dimatikan; pemulihannya hanya lewat SQL ke database
# produksi.
#
# Yang didapat akun yang tercantum di sini:
#   - boleh menonaktifkan / menurunkan / mereset super admin LAIN;
#   - tidak bisa disentuh dari layar mana pun, termasuk oleh sesama akar —
#     mencabutnya = keluarkan namanya dari sini lalu redeploy.
#
# USERNAME dipakai karena ia satu-satunya identitas yang TIDAK BISA diubah dari
# dalam aplikasi (email bisa diganti lewat "Edit nama", jadi memakainya berarti
# pagar ini bisa dipindahkan oleh orang yang seharusnya dijaga olehnya).
#
# Mencantumkan nama di sini TIDAK mengangkat siapa pun: perannya tetap wajib
# super_admin. Nama yang belum punya akun = kursi kosong yang hanya boleh diisi
# oleh super admin utama yang sudah ada.
SUPER_ADMIN_UTAMA=

# ── Cloudflare R2 (opsional — fitur upload nonaktif bila kosong) ──
# Endpoint S3: https://<accountid>.r2.cloudflarestorage.com (BUKAN r2.dev / custom domain)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── AI Intelligence Hub (opsional — fitur AI) ──
# Kunci enkripsi API key provider AI di database (AES-256-GCM).
# WAJIB di production bila fitur AI dipakai: openssl rand -hex 32
AI_SECRET_ENCRYPTION_KEY=

# Alamat publik MARLIN (skema + domain, tanpa garis miring di akhir).
# WAJIB bila OAuth Google Drive dipakai dan platform tidak mengirim
# x-forwarded-host (mis. host header berisi 0.0.0.0:8080).
# Di Railway biasanya cukup RAILWAY_PUBLIC_DOMAIN yang sudah otomatis ada.
APP_PUBLIC_URL=

# Cuaca laporan harian (opsional). Kosong = Open-Meteo publik, tanpa API key.
# Isi hanya bila memakai mirror/langganan berbayar dengan bentuk respons sama.
WEATHER_API_URL=

# Pekerjaan harian terjadwal (aktivasi SPMK + pengingat WA laporan harian).
# Dipicu penjadwal luar: POST /api/cron/harian dengan header x-cron-secret.
# Kosong = endpoint-nya menolak semua permintaan (fitur mati, bukan terbuka).
#
# Isinya string ACAK bebas — bukan password yang perlu diingat, tidak pernah
# diketik manusia. Satu-satunya syarat: sulit ditebak. Minimal 32 karakter;
# yang dipakai:  openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
# Jangan pakai nama proyek/tanggal/kata yang bisa ditebak, dan jangan
# dipakai ulang dari secret lain (SESSION_SECRET dsb).
CRON_SECRET=
