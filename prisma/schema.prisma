// ─────────────────────────────────────────────────────────────
// AI INTELLIGENCE HUB (DECISIONS 133)
// AI = penjelas, BUKAN sumber angka. Semua angka dari calc layer;
// run menyimpan snapshot sumber + output terstruktur tervalidasi.
// ─────────────────────────────────────────────────────────────

enum AiRunKind {
  pulse // Portfolio Pulse — ringkasan + prioritas lintas lokasi
  deviasi // Explain Variance — pisahkan data gap vs keterlambatan fisik
  risiko // Risk Intelligence — prioritisasi risiko
  kualitas_data // Audit Kualitas Data — penjelasan temuan rule
  laporan // Report Studio — draf laporan terstruktur
  tanya // Ask MARLIN — jawaban grounded
}

enum AiRunStatus {
  berjalan
  siap
  gagal
}

enum AiArtifactKind {
  laporan // draf laporan (Report Studio)
  saran // draft action/recovery usulan AI — TIDAK menulis domain
}

/// Lifecycle artefak laporan AI — terpisah dari DailyReport.
enum AiArtifactStatus {
  draft
  direview
  disetujui
  beku // immutable; siap distribusi
  terkirim
}

/// Satu eksekusi AI (satu panggilan provider per run). Usage inline (1 run = 1 call,
/// tabel terpisah tidak memberi nilai). sourcesJson = SourceRef[] utk drawer sumber.
model AiRun {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  runKind          AiRunKind   @map("run_kind")
  status           AiRunStatus @default(berjalan)
  scopeType        String      @map("scope_type") // location | package | all
  scopeIds         Json        @map("scope_ids") // string[] locationId TERRESOLVE (sudah di-intersect izin)
  periodStart      DateTime    @map("period_start") @db.Date
  periodEnd        DateTime    @map("period_end") @db.Date
  provider         String?
  model            String?
  promptVersion    String?     @map("prompt_version")
  inputHash        String?     @map("input_hash")
  sourceSnapshotAt DateTime?   @map("source_snapshot_at") @db.Timestamptz
  readinessScore   Int?        @map("readiness_score")
  confidence       Int?
  sourcesJson      Json?       @map("sources_json")
  outputJson       Json?       @map("output_json")
  limitations      Json?
  inputTokens      Int?        @map("input_tokens")
  outputTokens     Int?        @map("output_tokens")
  latencyMs        Int?        @map("latency_ms")
  estimatedCostUsd Decimal?    @map("estimated_cost_usd") @db.Decimal(12, 6)
  errorCode        String?     @map("error_code")
  errorMessage     String?     @map("error_message")
  startedAt        DateTime    @default(now()) @map("started_at") @db.Timestamptz
  finishedAt       DateTime?   @map("finished_at") @db.Timestamptz
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz

  artifacts AiArtifact[]
  messages  AiMessage[]

  @@index([userId, createdAt])
  @@index([runKind, createdAt])
  @@index([status, createdAt])
  @@map("ai_runs")
}

/// Artefak hasil run: laporan (lifecycle review→approve→freeze→distribute) atau
/// saran (draft action non-eksekusi). Regenerate = version baru (baris baru).
model AiArtifact {
  id                String           @id @default(uuid()) @db.Uuid
  // Nullable: artefak "saran" bisa dibuat dari temuan deterministik TANPA run AI.
  runId             String?          @map("run_id") @db.Uuid
  kind              AiArtifactKind
  templateKey       String?          @map("template_key")
  templateVersion   Int              @default(1) @map("template_version")
  version           Int              @default(1)
  status            AiArtifactStatus @default(draft)
  title             String
  structuredContent Json             @map("structured_content")
  renderedText      String?          @map("rendered_text") @db.Text
  humanEditNote     String?          @map("human_edit_note")
  createdById       String           @map("created_by_id") @db.Uuid
  reviewedById      String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?        @map("reviewed_at") @db.Timestamptz
  approvedById      String?          @map("approved_by_id") @db.Uuid
  approvedAt        DateTime?        @map("approved_at") @db.Timestamptz
  frozenAt          DateTime?        @map("frozen_at") @db.Timestamptz
  contentHash       String?          @map("content_hash")
  distributions     Json? // {at, channel, target, byId, hash}[]
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  run AiRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([kind, status])
  @@index([status, updatedAt])
  @@map("ai_artifacts")
}

/// Percakapan Ask MARLIN (scope + periode terkunci saat dibuat).
model AiConversation {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String?
  scopeIds    Json     @map("scope_ids") // string[] locationId terresolve
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  messages AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String // "user" | "asisten"
  content        String   @db.Text
  citations      Json? // SourceRef[] ringkas
  confidence     Int?
  runId          String?  @map("run_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run          AiRun?         @relation(fields: [runId], references: [id])

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// Lifecycle ringkasan chat grup — draf AI wajib direview manusia sebelum
/// difinalkan & dikirim. DECISIONS 139.
enum WaChatSummaryStatus {
  draft_ai
  edited_draft
  final
  sent
}

/// Ringkasan AI harian percakapan grup WA per paket (Layer B, DECISIONS 135).
/// Satu baris per (paket, tanggal Jakarta); regenerate menimpa (upsert).
model WaChatSummary {
  id            String              @id @default(uuid()) @db.Uuid
  packageId     String              @map("package_id") @db.Uuid
  summaryDate   DateTime            @map("summary_date") @db.Date
  messageCount  Int                 @map("message_count")
  summaryText   String              @map("summary_text") @db.Text
  provider      String?
  model         String?
  createdById   String?             @map("created_by_id") @db.Uuid
  // Lifecycle + jejak penyusunan (DECISIONS 139). Draf AI TIDAK PERNAH otomatis
  // final — harus dilewatkan review manusia sebelum dikirim ke pimpinan.
  status        WaChatSummaryStatus @default(draft_ai)
  version       Int                 @default(1)
  aiText        String?             @map("ai_text") @db.Text // draf AI asli (pembanding editan manusia)
  confidence    Int?
  marlinCount   Int                 @default(0) @map("marlin_count")
  excludedCount Int                 @default(0) @map("excluded_count")
  generatedById String?             @map("generated_by_id") @db.Uuid
  generatedAt   DateTime?           @map("generated_at") @db.Timestamptz
  editedById    String?             @map("edited_by_id") @db.Uuid
  editedAt      DateTime?           @map("edited_at") @db.Timestamptz
  finalizedById String?             @map("finalized_by_id") @db.Uuid
  finalizedAt   DateTime?           @map("finalized_at") @db.Timestamptz
  lastSentAt    DateTime?           @map("last_sent_at") @db.Timestamptz
  dispatches    Json? // {at, target, chatId, byId}[]
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, summaryDate])
  @@index([summaryDate])
  @@map("wa_chat_summaries")
}

/// Alias pengirim WhatsApp — memberi NAMA pada pengirim yang hanya dikenal
/// sebagai nomor/LID, supaya ringkasan ke pimpinan menyebut orang, bukan kode.
/// Kunci = JID mentah (…@c.us / …@lid) atau nomor polos. DECISIONS 138.
/// Berbeda dari WaContact: alias adalah jawaban atas "nomor ini siapa" —
/// faktanya sama untuk semua orang, jadi sengaja DIPAKAI BERSAMA se-organisasi
/// (DECISIONS 150). Dikelola di halaman Manajemen Kontak.
model WaSenderAlias {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  senderKey   String   @map("sender_key")
  displayName String   @map("display_name")
  role        String?
  note        String?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("WaSenderAliasCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([orgId, senderKey])
  @@index([orgId])
  @@map("wa_sender_aliases")
}

/// Catatan pengiriman pengingat laporan harian per orang per hari — SATU baris
/// per (user, tanggal). Unique-nya yang membuat penjadwal aman dijalankan
/// berkali-kali: percobaan kedua di hari yang sama akan menabrak, bukan
/// mengirim pesan dobel ke lapangan. DECISIONS 202.
model DailyReminderLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Tanggal kerja Asia/Jakarta (YYYY-MM-DD).
  dateKey   String   @map("date_key")
  /// Jumlah lokasi yang ditagih pada pesan itu.
  locations Int
  /// sukses | gagal
  status    String
  error     String?
  /// ID pesan dari WAHA. Ini SATU-SATUNYA bukti bahwa pesannya benar-benar
  /// diterima antrean WhatsApp; tanpa ini "sukses" hanya berarti "server
  /// menjawab 2xx", yang bisa terjadi walau tidak ada pesan yang keluar
  /// (DECISIONS 206).
  waMessageId String? @map("wa_message_id")
  /// Tujuan yang BENAR-BENAR dipakai saat mengirim (628…@c.us). Disimpan supaya
  /// "terkirim tapi tidak sampai" bisa ditelusuri ke nomornya, bukan ditebak.
  chatId    String?  @map("chat_id")
  /// Berapa kali pengingat hari itu dikirim. Cron mengirim sekali; admin boleh
  /// mengulang sebanyak yang ia mau (DECISIONS 207).
  attempts  Int      @default(1)
  lastSentAt DateTime? @map("last_sent_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, dateKey])
  @@index([dateKey])
  @@map("daily_reminder_logs")
}

// ─────────────────────────────────────────────────────────────
// IZIN PERANGKAT (GPS & kamera) — DECISIONS 219
// ─────────────────────────────────────────────────────────────

/// Catatan APPEND-ONLY keadaan izin browser milik seorang user di satu
/// perangkat. Sengaja log, bukan satu kolom di `User`: izin browser melekat ke
/// PERANGKAT + situs, bisa dicabut kapan saja, dan seorang mandor lazim
/// berganti HP. Satu kolom "sudah izin" akan berbohong begitu izinnya dicabut
/// atau ia pindah perangkat.
model DevicePermission {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// "geolocation" | "camera"
  kind       String
  /// "granted" | "denied" | "prompt" | "unsupported"
  state      String
  userAgent  String?  @map("user_agent")
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, recordedAt])
  @@map("device_permissions")
}

// ─────────────────────────────────────────────────────────────
// IMPOR & KUALITAS DATA (PRD FR-IMP) — DECISIONS 253/254
// ─────────────────────────────────────────────────────────────

/// Jenis berkas yang diimpor. Sengaja enum, bukan string bebas: daftar ini
/// dipakai menyaring riwayat, dan string bebas membuat "rab" dan "RAB" jadi
/// dua jalur impor yang berbeda di mata pengguna.
enum ImportKind {
  rab
  jadwal
  master_lokasi
  laporan_harian
  dokumen_drive
}

enum ImportStatus {
  diproses
  berhasil
  /// Sebagian baris diterima, sebagian ditolak — dan yang ditolak PUNYA alasan
  /// per baris di `ImportIssue`. Ini status yang paling sering terjadi dan
  /// paling sering hilang: tanpa tabel ini ia cuma banner yang menutup diri.
  sebagian
  gagal
}

enum ImportIssueSeverity {
  /// Barisnya TIDAK masuk.
  tolak
  /// Barisnya masuk, tapi ada yang perlu diketahui (mis. kolom kosong ditebak).
  peringatan
}

/// Satu kali unggah berkas: siapa, kapan, berkas apa, dan berapa yang masuk.
///
/// Sebelum ini hasil impor hanya hidup selama satu render — parser
/// mengembalikan `warnings: string[]`, banner menampilkannya, lalu hilang saat
/// halaman ditutup. Akibatnya pertanyaan yang paling sering muncul justru tidak
/// bisa dijawab: "RAB lokasi ini diimpor dari file mana, oleh siapa, dan baris
/// mana yang waktu itu ditolak?"
///
/// Tabel ini TIDAK menyimpan berkasnya, hanya jejaknya. Menyimpan berkas
/// berarti keputusan retensi & privasi tersendiri; jejaknya sudah cukup untuk
/// menjawab pertanyaan di atas.
model ImportJob {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  /// Null bila dijalankan proses terjadwal, bukan orang.
  userId       String?      @map("user_id") @db.Uuid
  locationId   String?      @map("location_id") @db.Uuid
  packageId    String?      @map("package_id") @db.Uuid
  kind         ImportKind
  status       ImportStatus @default(diproses)
  fileName     String       @map("file_name")
  fileBytes    Int          @default(0) @map("file_bytes")
  rowsRead     Int          @default(0) @map("rows_read")
  rowsAccepted Int          @default(0) @map("rows_accepted")
  rowsRejected Int          @default(0) @map("rows_rejected")
  /// Ringkasan sekalimat untuk daftar — rinciannya di `issues`.
  message      String?      @db.Text
  startedAt    DateTime     @default(now()) @map("started_at") @db.Timestamptz
  finishedAt   DateTime?    @map("finished_at") @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  location Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  package  Package?     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  issues   ImportIssue[]

  @@index([orgId, startedAt])
  @@index([kind, startedAt])
  @@index([locationId, startedAt])
  @@map("import_jobs")
}

/// Satu masalah pada satu baris. Nomor baris + kolom + nilai apa adanya, supaya
/// pengguna bisa membuka file aslinya dan langsung menuju barisnya — bukan
/// disuruh mencari sendiri apa yang salah dari pesan yang menyebut jumlah saja.
model ImportIssue {
  id        String              @id @default(uuid()) @db.Uuid
  jobId     String              @map("job_id") @db.Uuid
  severity  ImportIssueSeverity
  /// Nomor baris di berkas ASLI (1-based, termasuk header) — bukan indeks array.
  rowNumber Int?                @map("row_number")
  column    String?
  /// Nilai apa adanya dari sel, tanpa dinormalkan. DECISIONS 203: yang
  /// ditampilkan balik ke pengguna harus persis yang ia tulis.
  value     String?             @db.Text
  message   String              @db.Text

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, severity])
  @@map("import_issues")
}
