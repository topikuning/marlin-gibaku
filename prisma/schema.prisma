/// Kontak tujuan WA milik seorang user (per-pembuat). chatId = target WAHA:
/// grup "…@g.us", kontak "…@c.us", atau nomor polos. DECISIONS 122.
/// Relasi `owner` WAJIB ada (DECISIONS 150): tanpa itu kontak tidak bisa
/// disaring per organisasi — penyebab kebocoran lintas-tenant di direktori
/// pengenal pengirim.
model WaContact {
