/// Sumber waktu cap foto: exif (metadata foto), device (jam perangkat saat jepret),
/// filename (jam dari nama file WhatsApp yang EXIF-nya terbuang), server (fallback
/// waktu unggah — TIDAK pasti waktu jepret), manual.
enum PhotoMetadataSource {
  exif
  device
  filename
  server
  manual
}

/// Asal KOORDINAT yang tercap di foto. Dipisah dari waktu (PhotoMetadataSource)
/// karena keduanya bisa berbeda sumber. `project` = titik lokasi proyek dari
/// database — cadangan saat foto tidak membawa GPS; itu BUKAN posisi foto dan
/// tidak boleh dihitung sebagai bukti GPS (DECISIONS 197).
enum PhotoGpsSource {
  exif
  device
  project
  /// Diketik manusia saat perbaikan cap — bukan bacaan alat. Ditandai di cap
  /// dan TIDAK dihitung sebagai bukti GPS (DECISIONS 198).
  manual
  none
}

/// Master data jenis kegiatan lapangan — bisa dikelola admin di Sistem (tambah/
/// ubah/nonaktif). Menggantikan enum FieldActivityType supaya jenis kegiatan
/// tidak lagi hardcode. `key` = slug stabil yang disimpan di FieldActivity.type.
model FieldActivityKind {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("field_activity_kinds")
}

