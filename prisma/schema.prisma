// MARLIN · Prisma Schema (rebuild)
// Sumber keputusan: docs/rebuild/DOMAIN_MODEL.md
// Naming: snake_case DB via @map/@@map, camelCase TS.
// Uang = BigInt rupiah. Volume = Decimal(15,3). Waktu = Timestamptz (logika Asia/Jakarta).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum UserRole {
  super_admin
  program_director
  regional_manager
  project_manager
  site_manager
  field_supervisor
  exec_viewer
  /// Wakil pemberi kerja — BACA SAJA, tanpa AI, hanya lokasi yang ditugaskan.
  /// DECISIONS 199.
  wakil_ppk
}

/// Lifecycle paket — SATU funnel (menggantikan ProspekStage + ProcurementStage + DocumentStage lama)
enum PackageStage {
  prospek
  tender
  penetapan
  kontrak
  pelaksanaan
  serah_terima
  selesai
  batal
}

