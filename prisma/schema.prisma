// ─────────────────────────────────────────────────────────────
// IDENTITAS & AKSES
// ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users           User[]
  packages        Package[]
  vendors         Vendor[]
  documents       Document[]
  masterLocations MasterLocation[]
  waSenderAliases WaSenderAlias[]
  importJobs      ImportJob[]

  @@map("organizations")
}

/// Katalog lokasi "tertanam di awal" — BELUM terikat paket/kontrak. Sumber data
/// awal (impor lokasi_awal.xlsx). Dipakai menu bypass admin untuk membuat proyek
/// langsung ke tahap Kontrak: satu master → satu Location riil (assignedLocation).
/// Perusahaan (candidateVendor) hanya hint teks — TIDAK dihubungkan relasional
/// ke lokasi; master perusahaan tetap tabel Vendor.
model MasterLocation {
  id                 String   @id @default(uuid()) @db.Uuid
  orgId              String   @map("org_id") @db.Uuid
  province           String
  regency            String
  district           String?
  village            String
  latitude           Decimal? @db.Decimal(10, 7)
  longitude          Decimal? @db.Decimal(10, 7)
  candidateVendor    String?  @map("candidate_vendor")
  assignedLocationId String?  @unique @map("assigned_location_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization     Organization @relation(fields: [orgId], references: [id])
  assignedLocation Location?    @relation(fields: [assignedLocationId], references: [id])

  @@unique([orgId, province, regency, district, village])
  @@index([orgId])
  @@map("master_locations")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  orgId              String    @map("org_id") @db.Uuid
  username           String?   @unique
  email              String?   @unique
  phone              String?   @map("phone")
  fullName           String    @map("full_name")
  passwordHash       String    @map("password_hash")
  role               UserRole
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  tokenVersion       Int       @default(0) @map("token_version")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  // Pembuat akun (berjenjang: PM→SM/Pelaksana, SM→Pelaksana). Null utk akun awal/seed.
  /// Nomor WhatsApp (format 62xxxxxxxxxx, hasil normalizeWaTarget). Dipakai
  /// pengingat laporan harian (DECISIONS 202). null = tidak dikirimi apa pun.
  waNumber     String?  @map("wa_number")
  createdById        String?   @map("created_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization         @relation(fields: [orgId], references: [id])
  sessions     Session[]
  assignments  LocationAssignment[]
  auditLogs    AuditLog[]
  creator      User?                @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers User[]               @relation("UserCreator")
  waContacts   WaContact[]          @relation("WaContactOwner")
  waAliases    WaSenderAlias[]      @relation("WaSenderAliasCreator")

  @@index([orgId])
  @@index([role])
  @@index([createdById])
  devicePermissions DevicePermission[]
  rabApprovals      RabRevisionApproval[]
  importJobs        ImportJob[]

  @@map("users")
}

/// Session DB-backed: revocable. id = SHA-256 hash token (token asli hanya di cookie).
model Session {
  id           String    @id
  userId       String    @map("user_id") @db.Uuid
  tokenVersion Int       @map("token_version")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

/// Rate limit login per identifier+IP (sliding window)
model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  ip         String
  success    Boolean
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model LocationAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  locationId   String    @map("location_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  unassignedAt DateTime? @map("unassigned_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([locationId])
  @@map("location_assignments")
}

// ─────────────────────────────────────────────────────────────
// PAKET, KONTRAK, LOKASI
// ─────────────────────────────────────────────────────────────

/// Spine lifecycle: prospek → tender → penetapan → kontrak → pelaksanaan → serah_terima → selesai | batal
model Package {
  id                  String       @id @default(uuid()) @db.Uuid
  orgId               String       @map("org_id") @db.Uuid
  name                String
  packageNumber       String?      @map("package_number")
  ownerAgency         String       @default("KKP") @map("owner_agency")
  hpsValue            BigInt       @default(0) @map("hps_value")
  stage               PackageStage @default(prospek)
  province            String?
  candidateVendorName String?      @map("candidate_vendor_name")
  note                String?
  // Dibuat via jalur cepat admin (bypass proses pra-kontrak); dokumen menyusul.
  isBypass            Boolean      @default(false) @map("is_bypass")
  cancelReason        String?      @map("cancel_reason")
  // Grup WhatsApp tujuan kiriman laporan/kegiatan paket ini (WAHA chatId, mis.
  // "12036300...@g.us"). Semua lokasi di paket ini mengirim ke grup yang sama.
  waGroupId           String?      @map("wa_group_id")
  waGroupName         String?      @map("wa_group_name")
  // Folder Google Drive paket (pemberian KKP) — tujuan upload PDF/Excel laporan.
  driveFolderId       String?      @map("drive_folder_id")
  createdById         String?      @map("created_by_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization          @relation(fields: [orgId], references: [id])
  contract        Contract?
  locations       Location[]
  stageHistory    PackageStageHistory[]
  documents       Document[]
  milestones      AdminMilestone[]
  waMessages      WaMessage[]
  waChatSummaries WaChatSummary[]
  gdriveUploads   GDriveUpload[]
  importJobs      ImportJob[]

  @@index([orgId, stage])
  @@map("packages")
}

/// Log upload laporan ke folder Google Drive paket (append-only). Baris terbaru
/// per (paket, kind, refKey) = status terkini; gagal tetap tercatat supaya bisa
/// diulang & diaudit. DECISIONS 141.
model GDriveUpload {
  id          String   @id @default(uuid()) @db.Uuid
  packageId   String   @map("package_id") @db.Uuid
  locationId  String?  @map("location_id") @db.Uuid
  /// laporan_harian | laporan_mingguan | laporan_bulanan
  kind        String
  /// Kunci periode: dateKey (harian) atau nomor periode (mingguan/bulanan).
  refKey      String   @map("ref_key")
  fileName    String   @map("file_name")
  fileId      String?  @map("file_id")
  webLink     String?  @map("web_link")
  /// sukses | gagal
  status      String
  error       String?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, kind, refKey, createdAt])
  @@map("gdrive_uploads")
}

/// Pesan grup WhatsApp yang tertangkap via webhook WAHA (inbound). Fondasi
/// integrasi AI: arsip percakapan lapangan per paket untuk diringkas/ditelusur.
/// Hanya menyimpan pesan dari grup yang tertaut paket (Package.waGroupId).
/// DECISIONS 119.
model WaMessage {
  id          String   @id @default(uuid()) @db.Uuid
  packageId   String?  @map("package_id") @db.Uuid
  chatId      String   @map("chat_id")
  waMessageId String   @unique @map("wa_message_id") // id pesan WAHA — dedup
  fromNumber  String?  @map("from_number")
  fromName    String?  @map("from_name")
  // JID mentah pengirim (…@c.us / …@lid). Perlu dibedakan: @lid = identitas
  // privasi WhatsApp, TIDAK mengandung nomor telepon. DECISIONS 138.
  senderJid   String?  @map("sender_jid")
  body        String   @db.Text
  hasMedia    Boolean  @default(false) @map("has_media")
  mediaType   String?  @map("media_type")
  fromMe      Boolean  @default(false) @map("from_me")
  timestamp   DateTime @db.Timestamptz // waktu pesan (dari WAHA)
  raw         Json?    @db.JsonB // event mentah (audit/debug)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([packageId, timestamp])
  @@index([chatId, timestamp])
  @@map("wa_messages")
}

/// Cache pengamatan cuaca per lokasi per tanggal (sumber luar, bukan angka
/// turunan MARLIN). Satu baris = satu hari untuk satu lokasi; dipakai ulang
/// oleh laporan harian supaya tidak memanggil API berulang (83 lokasi × 1/hari).
/// Jam hujan TIDAK disimpan — diturunkan dari `hourly` saat dibutuhkan.
model WeatherObservation {
  id         String   @id @default(uuid()) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  observedOn DateTime @map("observed_on") @db.Date
  /// Penyedia data ("open-meteo") — dicatat demi jejak asal-usul di laporan.
  provider   String
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  /// [{ hour: 7, category: "Cerah"|"Mendung"|"Hujan", precipMm: number, code: number }]
  hourly     Json
  fetchedAt  DateTime @default(now()) @map("fetched_at") @db.Timestamptz

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, observedOn])
  @@map("weather_observations")
}

/// APPEND-ONLY (trigger): histori transisi stage paket
model PackageStageHistory {
  id          String        @id @default(uuid()) @db.Uuid
  packageId   String        @map("package_id") @db.Uuid
  fromStage   PackageStage? @map("from_stage")
  toStage     PackageStage  @map("to_stage")
  /// null = dilakukan SISTEM (aktivasi SPMK terjadwal, DECISIONS 202).
  changedById String?       @map("changed_by_id") @db.Uuid
  changedAt   DateTime      @default(now()) @map("changed_at") @db.Timestamptz
  note        String?

  package Package @relation(fields: [packageId], references: [id])

  @@index([packageId, changedAt])
  @@map("package_stage_history")
}

model Vendor {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  npwp      String?
  contact   String?
  // Master data perusahaan — dasar kop surat & logo (DECISIONS 134).
  address   String?
  phone     String?
  email     String?
  logoKey   String?  @map("logo_key") // key R2 logo perusahaan
  kopKey    String?  @map("kop_key") // key R2 gambar kop surat (desain jadi milik perusahaan)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [orgId], references: [id])
  contracts    Contract[]
  commitments  Commitment[]

  @@unique([orgId, name])
  @@map("vendors")
}

model Contract {
  id                    String    @id @default(uuid()) @db.Uuid
  packageId             String    @unique @map("package_id") @db.Uuid
  vendorId              String    @map("vendor_id") @db.Uuid
  contractNumber        String    @unique @map("contract_number")
  // Nama pekerjaan RESMI (judul kontrak, biasanya panjang) — untuk dokumen/cetak.
  // Terpisah dari Package.name (label pendek untuk daftar/tampilan).
  workTitle             String?   @map("work_title")
  contractValue         BigInt    @map("contract_value")
  ppnPercent            Decimal   @default(11) @map("ppn_percent") @db.Decimal(5, 2)
  advancePercent        Decimal?  @map("advance_percent") @db.Decimal(5, 2)
  retentionPercent      Decimal?  @map("retention_percent") @db.Decimal(5, 2)
  signedDate            DateTime  @map("signed_date") @db.Date
  // Masa pelaksanaan (hari kalender) = tulang punggung jadwal. Tanggal mulai
  // (SPMK) & selesai baru terisi saat SPMK terbit — sebelum itu null (jadwal
  // relatif dari durationDays; kalender belum terpetakan).
  durationDays          Int       @default(150) @map("duration_days")
  startDate             DateTime? @map("start_date") @db.Date
  endDate               DateTime? @map("end_date") @db.Date
  paymentTerms          String?   @map("payment_terms")
  // Penanda tangan dokumen KKP (opsional, bisa diganti kapan saja bila ada
  // pergantian personel). PPK = pihak KKP; Pengawas = konsultan; Penyedia = pelaksana.
  ppkName               String?   @map("ppk_name")
  ppkNip                String?   @map("ppk_nip")
  supervisorName        String?   @map("supervisor_name")
  supervisorFirm        String?   @map("supervisor_firm")
  contractorSignerName  String?   @map("contractor_signer_name")
  contractorSignerTitle String?   @map("contractor_signer_title")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  package       Package             @relation(fields: [packageId], references: [id])
  vendor        Vendor              @relation(fields: [vendorId], references: [id])
  amendments    ContractAmendment[]
  ownerBillings OwnerBilling[]
  documents     Document[]

  @@index([vendorId])
  @@map("contracts")
}

/// APPEND-ONLY (trigger): adendum/CCO
model ContractAmendment {
  id            String   @id @default(uuid()) @db.Uuid
  contractId    String   @map("contract_id") @db.Uuid
  ccoNumber     String   @map("cco_number")
  valueDelta    BigInt   @map("value_delta")
  endDateDelta  Int      @map("end_date_delta")
  effectiveDate DateTime @map("effective_date") @db.Date
  reason        String
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  contract     Contract      @relation(fields: [contractId], references: [id])
  documents    Document[]
  rabRevisions RabRevision[]

  @@unique([contractId, ccoNumber])
  @@map("contract_amendments")
}

model Location {
  id        String         @id @default(uuid()) @db.Uuid
  packageId String         @map("package_id") @db.Uuid
  name      String
  slug      String         @unique
  village   String
  district  String? // kecamatan (opsional)
  regency   String
  province  String
  gpsLat    Decimal?       @map("gps_lat") @db.Decimal(10, 7)
  gpsLng    Decimal?       @map("gps_lng") @db.Decimal(10, 7)
  status    LocationStatus @default(persiapan)
  isActive  Boolean        @default(false) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  package             Package                 @relation(fields: [packageId], references: [id])
  statusHistory       LocationStatusHistory[]
  assignments         LocationAssignment[]
  rabRevisions        RabRevision[]
  baselines           Baseline[]
  weeklyPlans         WeeklyPlan[]
  dailyReports        DailyReport[]
  fieldActivities     FieldActivity[]
  issues              Issue[]
  budgetLines         BudgetLine[]
  commitments         Commitment[]
  expenses            Expense[]
  invoices            Invoice[]
  documents           Document[]
  milestones          AdminMilestone[]
  alerts              Alert[]
  photos              Photo[]
  weatherObservations WeatherObservation[]
  masterLocation      MasterLocation?
  importJobs          ImportJob[]

  @@index([packageId])
  @@index([province])
  @@index([status])
  @@map("locations")
}

/// APPEND-ONLY (trigger)
model LocationStatusHistory {
  id          String          @id @default(uuid()) @db.Uuid
  locationId  String          @map("location_id") @db.Uuid
  fromStatus  LocationStatus? @map("from_status")
  toStatus    LocationStatus  @map("to_status")
  /// null = dilakukan SISTEM (mis. aktivasi SPMK terjadwal, DECISIONS 202).
  /// Tindakan otomatis tidak boleh diatribusikan ke manusia mana pun.
  changedById String?         @map("changed_by_id") @db.Uuid
  changedAt   DateTime        @default(now()) @map("changed_at") @db.Timestamptz
  note        String?

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, changedAt])
  @@map("location_status_history")
}

// ─────────────────────────────────────────────────────────────
// RAB & BASELINE
// ─────────────────────────────────────────────────────────────

model RabRevision {
  id               String            @id @default(uuid()) @db.Uuid
  locationId       String            @map("location_id") @db.Uuid
  revisionNo       Int               @map("revision_no")
  source           RabRevisionSource
  amendmentId      String?           @map("amendment_id") @db.Uuid
  status           RevisionStatus    @default(draft)
  totalValue       BigInt            @map("total_value")
  note             String?
  sourceDocumentId String?           @map("source_document_id") @db.Uuid
  createdById      String?           @map("created_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  /// Disentuh setiap mutasi draft (editor SELALU menulis ulang totalValue) —
  /// dipakai untuk MENGGUGURKAN persetujuan aktivasi yang diberikan sebelum
  /// isinya berubah. DECISIONS 234.
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  supersededAt     DateTime?         @map("superseded_at") @db.Timestamptz

  location       Location               @relation(fields: [locationId], references: [id])
  amendment      ContractAmendment?     @relation(fields: [amendmentId], references: [id])
  sourceDocument Document?              @relation("rabSourceDoc", fields: [sourceDocumentId], references: [id])
  nodes          RabNode[]
  baselines      Baseline[]
  approvals      RabRevisionApproval[]

  @@unique([locationId, revisionNo])
  @@index([locationId, status])
  @@map("rab_revisions")
}

/// Persetujuan aktivasi revisi RAB — aturan EMPAT MATA (DECISIONS 234).
///
/// Mengaktifkan adendum mengganti RAB kontrak yang berlaku dan me-regenerate
/// kurva-S, jadi tidak boleh bisa dilakukan satu orang. Syaratnya dua orang
/// BERBEDA: satu Program Director + satu peran penugasan (AM/PM/SM).
/// Append-only: pencabutan diwakili baris yang dihapus + jejak audit.
model RabRevisionApproval {
  id         String   @id @default(uuid()) @db.Uuid
  revisionId String   @map("revision_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// Peran SAAT menyetujui — disnapshot, bukan dibaca ulang saat aktivasi.
  /// Peran orang bisa berubah; tanda tangan yang sudah diberikan tidak.
  role       UserRole
  /// Nilai draft saat disetujui — untuk jejak "menyetujui angka yang mana".
  totalValue BigInt   @map("total_value")
  approvedAt DateTime @default(now()) @map("approved_at") @db.Timestamptz

  revision RabRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id])

  @@unique([revisionId, userId])
  @@index([revisionId])
  @@map("rab_revision_approvals")
}

/// Pohon RAB satu tabel (kategori → sub → grup → item).
/// lineageKey = path stabil ("I#6.1#a") untuk carry-over realisasi lintas revisi.
model RabNode {
  id         String      @id @default(uuid()) @db.Uuid
  revisionId String      @map("revision_id") @db.Uuid
  parentId   String?     @map("parent_id") @db.Uuid
  kind       RabNodeKind
  code       String
  name       String
  volume     Decimal?    @db.Decimal(15, 3)
  unit       String?
  unitPrice  Decimal?    @map("unit_price") @db.Decimal(15, 2)
  amount     BigInt      @default(0)
  lineageKey String      @map("lineage_key")
  sortOrder  Int         @map("sort_order")

  revision    RabRevision       @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  parent      RabNode?          @relation("rabTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    RabNode[]         @relation("rabTree")
  reportItems DailyReportItem[]
  planItems   WeeklyPlanItem[]

  @@unique([revisionId, lineageKey])
  @@index([revisionId, parentId, sortOrder])
  @@index([revisionId, kind])
  @@map("rab_nodes")
}

/// Kurva-S rencana ber-versi (dulu ScurvePlan)
model Baseline {
  id            String         @id @default(uuid()) @db.Uuid
  locationId    String         @map("location_id") @db.Uuid
  baselineNo    Int            @map("baseline_no")
  source        BaselineSource
  status        RevisionStatus @default(aktif)
  rabRevisionId String?        @map("rab_revision_id") @db.Uuid
  contractDays  Int            @map("contract_days")
  note          String?
  createdById   String?        @map("created_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  supersededAt  DateTime?      @map("superseded_at") @db.Timestamptz

  location      Location               @relation(fields: [locationId], references: [id])
  rabRevision   RabRevision?           @relation(fields: [rabRevisionId], references: [id])
  points        BaselinePoint[]
  scheduleItems BaselineScheduleItem[]

  @@unique([locationId, baselineNo])
  @@index([locationId, status])
  @@map("baselines")
}

/// Jadwal per pekerjaan (kategori RAB) yang MENGHASILKAN baseline. BENTUK
/// KANONIK = matriks bobot per-minggu (`weekly`: array increment %/minggu,
/// panjang = totalWeeks) — BUKAN satu jendela mulai–selesai. Ini mendukung
/// minggu TERPUTUS (jeda) dan bisa di-round-trip dari/ke Excel. `weightPct` =
/// Σ weekly (disimpan utk tampilan/urutan). Kurva baseline = Σ semua weekly lalu
/// diakumulasi. Disimpan agar jadwal bisa dibuka & disesuaikan lagi. DECISIONS 103.
model BaselineScheduleItem {
  id         String  @id @default(uuid()) @db.Uuid
  baselineId String  @map("baseline_id") @db.Uuid
  lineageKey String  @map("lineage_key")
  name       String
  weightPct  Decimal @map("weight_pct") @db.Decimal(6, 3)
  /// Increment bobot per minggu (number[], panjang totalWeeks). 0 = minggu tak aktif (jeda).
  weekly     Json    @default("[]")

  baseline Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  @@unique([baselineId, lineageKey])
  @@map("baseline_schedule_items")
}

model BaselinePoint {
  id         String  @id @default(uuid()) @db.Uuid
  baselineId String  @map("baseline_id") @db.Uuid
  weekNumber Int     @map("week_number")
  plannedPct Decimal @map("planned_pct") @db.Decimal(6, 3)

  baseline Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  @@unique([baselineId, weekNumber])
  @@map("baseline_points")
}

model WeeklyPlan {
  id          String   @id @default(uuid()) @db.Uuid
  locationId  String   @map("location_id") @db.Uuid
  weekNumber  Int      @map("week_number")
  weekStart   DateTime @map("week_start") @db.Date
  weekEnd     DateTime @map("week_end") @db.Date
  note        String?
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  location Location         @relation(fields: [locationId], references: [id])
  items    WeeklyPlanItem[]

  @@unique([locationId, weekNumber])
  @@map("weekly_plans")
}

model WeeklyPlanItem {
  id           String  @id @default(uuid()) @db.Uuid
  weeklyPlanId String  @map("weekly_plan_id") @db.Uuid
  rabNodeId    String  @map("rab_node_id") @db.Uuid
  targetVolume Decimal @map("target_volume") @db.Decimal(15, 3)
  priority     Int     @default(5)
  picName      String? @map("pic_name")
  note         String?

  plan    WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  rabNode RabNode    @relation(fields: [rabNodeId], references: [id])

  @@unique([weeklyPlanId, rabNodeId])
  @@map("weekly_plan_items")
}

// ─────────────────────────────────────────────────────────────
// PELAKSANAAN HARIAN (SATU entitas laporan)
// ─────────────────────────────────────────────────────────────

model DailyReport {
  id               String            @id @default(uuid()) @db.Uuid
  locationId       String            @map("location_id") @db.Uuid
  reportDate       DateTime          @map("report_date") @db.Date
  status           DailyReportStatus @default(draft)
  weather          WeatherCode?
  /// Kondisi cuaca per jam 07:00–21:00 WIB (15 entri) — blanko KKP meminta
  /// centang per jam, bukan satu kategori untuk sehari penuh.
  /// Bentuk: [{ hour: 7, category: "Cerah"|"Mendung"|"Hujan", precipMm: number }]
  weatherHourly    Json?             @map("weather_hourly")
  weatherSource    WeatherSource?    @map("weather_source")
  weatherFetchedAt DateTime?         @map("weather_fetched_at") @db.Timestamptz
  workStart        String?           @map("work_start")
  workEnd          String?           @map("work_end")
  notes            String?
  gpsLat           Decimal?          @map("gps_lat") @db.Decimal(10, 7)
  gpsLng           Decimal?          @map("gps_lng") @db.Decimal(10, 7)
  createdById      String            @map("created_by_id") @db.Uuid
  submittedById    String?           @map("submitted_by_id") @db.Uuid
  submittedAt      DateTime?         @map("submitted_at") @db.Timestamptz
  verifiedById     String?           @map("verified_by_id") @db.Uuid
  verifiedAt       DateTime?         @map("verified_at") @db.Timestamptz
  finalizedById    String?           @map("finalized_by_id") @db.Uuid
  finalizedAt      DateTime?         @map("finalized_at") @db.Timestamptz
  finalSnapshot    Json?             @map("final_snapshot")
  /// Bagian mana yang diminta diperbaiki saat laporan dikembalikan (DECISIONS
  /// 256). Kosong = pengembalian tanpa penunjuk bagian — termasuk SELURUH
  /// laporan lama, yang memang tidak punya data ini dan tidak boleh dikarang.
  correctionAreas  CorrectionArea[]  @default([]) @map("correction_areas")
  // Penanda kiriman laporan ke grup WhatsApp (info "sudah dikirim").
  waSentAt         DateTime?         @map("wa_sent_at") @db.Timestamptz
  waSentById       String?           @map("wa_sent_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  location      Location                   @relation(fields: [locationId], references: [id])
  items         DailyReportItem[]
  workers       DailyReportWorker[]
  materials     DailyReportMaterial[]
  equipment     DailyReportEquipment[]
  statusHistory DailyReportStatusHistory[]
  photos        Photo[]
  issues        Issue[]

  @@unique([locationId, reportDate])
  @@index([status])
  @@index([locationId, status])
  @@map("daily_reports")
}

/// APPEND-ONLY (trigger): histori transisi + alasan koreksi
model DailyReportStatusHistory {
  id          String             @id @default(uuid()) @db.Uuid
  reportId    String             @map("report_id") @db.Uuid
  fromStatus  DailyReportStatus? @map("from_status")
  toStatus    DailyReportStatus  @map("to_status")
  changedById String             @map("changed_by_id") @db.Uuid
  changedAt   DateTime           @default(now()) @map("changed_at") @db.Timestamptz
  reason      String?

  report DailyReport @relation(fields: [reportId], references: [id])

  @@index([reportId, changedAt])
  @@map("daily_report_status_history")
}

/// Kegiatan lapangan NON-PEKERJAAN (dokumentasi foto) — mis. rapat PCM,
/// pengukuran/uitzet/MC-0, sosialisasi, mobilisasi, dokumentasi kondisi 0%.
/// Terpisah dari DailyReport (yang mengukur progres volume RAB): tak butuh
/// SPMK/minggu, boleh banyak per hari, alur ringkas draft → final.
model FieldActivity {
  id            String              @id @default(uuid()) @db.Uuid
  locationId    String              @map("location_id") @db.Uuid
  activityDate  DateTime            @map("activity_date") @db.Date
  // Jenis kegiatan = key master FieldActivityKind (bukan enum lagi).
  type          String
  title         String
  notes         String?
  participants  String?             @map("participants")
  kendala       String?             @map("kendala")
  solusi        String?             @map("solusi")
  gpsLat        Decimal?            @map("gps_lat") @db.Decimal(10, 7)
  gpsLng        Decimal?            @map("gps_lng") @db.Decimal(10, 7)
  status        FieldActivityStatus @default(draft)
  createdById   String              @map("created_by_id") @db.Uuid
  finalizedById String?             @map("finalized_by_id") @db.Uuid
  finalizedAt   DateTime?           @map("finalized_at") @db.Timestamptz
  // Penanda kiriman ke grup WhatsApp (WAHA) — untuk info "sudah dikirim" & hindari dobel.
  waSentAt      DateTime?           @map("wa_sent_at") @db.Timestamptz
  waSentById    String?             @map("wa_sent_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  location    Location                  @relation(fields: [locationId], references: [id])
  photos      Photo[]
  attachments FieldActivityAttachment[]

  @@index([locationId, activityDate])
  @@index([locationId, status])
  @@map("field_activities")
}

/// Lampiran non-foto kegiatan lapangan (PDF/Word/Excel/gambar) — ringkas,
/// menempel langsung ke kegiatan; TIDAK masuk Document Center formal (tanpa
/// taksonomi phase/type). File di R2, metadata di sini.
model FieldActivityAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  activityId   String   @map("activity_id") @db.Uuid
  r2Key        String   @unique @map("r2_key")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  bytes        Int
  sha256       String
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  activity FieldActivity @relation(fields: [activityId], references: [id])

  @@index([activityId])
  @@map("field_activity_attachments")
}

model DailyReportItem {
  id           String   @id @default(uuid()) @db.Uuid
  reportId     String   @map("report_id") @db.Uuid
  rabNodeId    String   @map("rab_node_id") @db.Uuid
  lineageKey   String   @map("lineage_key")
  /// Terhadap RAB yang mana baris ini dilaporkan (DECISIONS 210):
  /// `aktif` = RAB kontrak yang berlaku · `draft_adendum` = RAB pengajuan
  /// adendum yang BELUM resmi. Angka resmi (progres, kurva-S, keuangan, KKP)
  /// hanya menghitung `aktif`. Di lapangan pekerjaan sering jalan lebih dulu
  /// dan adendumnya menyusul — itu keadaan nyata, bukan kesalahan input, jadi
  /// dicatat apa adanya dengan penanda, bukan dipaksa masuk angka resmi.
  basis        String   @default("aktif")
  volumeDone   Decimal  @map("volume_done") @db.Decimal(15, 3)
  valueDone    BigInt   @map("value_done")
  notes        String?
  reportedById String?  @map("reported_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  report  DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  rabNode RabNode     @relation(fields: [rabNodeId], references: [id])
  photos  Photo[]

  @@unique([reportId, lineageKey])
  @@index([lineageKey])
  @@index([basis])
  @@map("daily_report_items")
}

model DailyReportWorker {
  id       String     @id @default(uuid()) @db.Uuid
  reportId String     @map("report_id") @db.Uuid
  role     WorkerRole
  count    Int        @default(0)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, role])
  @@map("daily_report_workers")
}

model DailyReportMaterial {
  id          String   @id @default(uuid()) @db.Uuid
  reportId    String   @map("report_id") @db.Uuid
  name        String
  unit        String?
  qtyReceived Decimal? @map("qty_received") @db.Decimal(15, 3)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("daily_report_materials")
}

model DailyReportEquipment {
  id       String @id @default(uuid()) @db.Uuid
  reportId String @map("report_id") @db.Uuid
  name     String
  count    Int    @default(1)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("daily_report_equipment")
}

model Photo {
  id             String              @id @default(uuid()) @db.Uuid
  /// Lokasi pemilik foto — SCOPE dedup (STORE-01). Foto byte-identik yang sah
  /// dipakai di dua lokasi (papan nama tipikal, dokumen yang sama) tidak boleh
  /// saling menolak; yang dicegah hanya kirim ulang di lokasi yang SAMA.
  locationId     String?             @map("location_id") @db.Uuid
  reportId       String?             @map("report_id") @db.Uuid
  reportItemId   String?             @map("report_item_id") @db.Uuid
  activityId     String?             @map("activity_id") @db.Uuid
  r2Key          String              @unique @map("r2_key")
  thumbnailKey   String?             @map("thumbnail_key")
  /// Berkas ASLI apa adanya (sebelum kompresi & cap) — arsip bukti mentah.
  /// null = foto lama, diunggah sebelum arsip asli ada (DECISIONS 197).
  originalKey    String?             @map("original_key")
  originalBytes  Int?                @map("original_bytes")
  sha256         String
  bytes          Int
  widthPx        Int?                @map("width_px")
  heightPx       Int?                @map("height_px")
  /// Koordinat yang TERCAP di foto — belum tentu dari EXIF (lihat `gpsSource`).
  /// Nama kolom dipertahankan demi kompatibilitas data lama.
  exifGpsLat     Decimal?            @map("exif_gps_lat") @db.Decimal(10, 7)
  exifGpsLng     Decimal?            @map("exif_gps_lng") @db.Decimal(10, 7)
  gpsSource      PhotoGpsSource      @default(none) @map("gps_source")
  /// Photo ID yang TERCETAK di cap (KODE-YYMMDD-HHMM-URUT). Disimpan supaya
  /// identitas foto TIDAK berubah saat capnya diperbaiki — ID itu sudah beredar
  /// di berkas yang diserahkan. null = foto lama (sebelum kolom ini ada).
  stampPhotoId   String?             @map("stamp_photo_id")
  /// Berapa kali cap foto ini diperbaiki. 0 = cap asli dari unggahan.
  stampRevision  Int                 @default(0) @map("stamp_revision")
  /// Arsip asli DIHAPUS sengaja (bukan "tidak pernah ada"). Setelah ini cap
  /// foto tsb tidak bisa diperbaiki lagi. DECISIONS 198.
  originalPurgedAt   DateTime? @map("original_purged_at") @db.Timestamptz
  originalPurgedById String?   @map("original_purged_by_id") @db.Uuid
  exifTakenAt    DateTime?           @map("exif_taken_at") @db.Timestamptz
  /// USANG (DECISIONS 250) — JANGAN DIPAKAI LAGI, dan jangan diisi.
  /// Kolom ini tidak pernah dinaikkan dari `pending` oleh kode mana pun: tidak
  /// ada aksi, UI, maupun capability yang menulisnya, sehingga "Terverifikasi"
  /// di galeri selalu 0 dan chip "Tanpa GPS" (yang menyaring `flagged_gps`)
  /// selalu nol hasil. Status foto kini DITURUNKAN dari laporan/kegiatan
  /// induknya — lihat `src/lib/photo-status.ts`. Kolomnya belum di-drop karena
  /// isinya di produksi belum diperiksa; lihat OPEN_ISSUES.
  verification   PhotoVerification   @default(pending)
  metadataSource PhotoMetadataSource @default(server) @map("metadata_source")
  uploadedById   String?             @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz

  location   Location?        @relation(fields: [locationId], references: [id])
  report     DailyReport?     @relation(fields: [reportId], references: [id])
  reportItem DailyReportItem? @relation(fields: [reportItemId], references: [id])
  activity   FieldActivity?   @relation(fields: [activityId], references: [id])

  stampRevisions PhotoStampRevision[]

  @@unique([locationId, sha256])
  @@index([reportId])
  @@index([reportItemId])
  @@index([activityId])
  @@index([locationId])
  @@index([gpsSource])
  @@index([stampPhotoId])
  @@map("photos")
}

/// Riwayat perbaikan cap foto — APPEND-ONLY (trigger DB). Cap dibakar ke gambar
/// dan versi lamanya dibuang, jadi baris inilah satu-satunya catatan apa yang
/// dulu tertulis di foto. Wajib ada sebelum cap boleh ditimpa. DECISIONS 198.
model PhotoStampRevision {
  id       String @id @default(uuid()) @db.Uuid
  photoId  String @map("photo_id") @db.Uuid
  /// Nomor revisi hasil (1 = perbaikan pertama).
  revision Int
  /// Alasan perbaikan — WAJIB diisi manusia, tidak boleh kosong.
  reason   String
  /// Nilai cap SEBELUM dan SESUDAH (waktu, koordinat, teks, sumber).
  before   Json
  after    Json
  /// Field yang nilainya DIKETIK manusia (bukan diambil ulang dari data).
  manualFields String[] @map("manual_fields")
  changedById  String   @map("changed_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, revision])
  @@index([photoId])
  @@map("photo_stamp_revisions")
}

// ─────────────────────────────────────────────────────────────
// ISU & PEMULIHAN
// ─────────────────────────────────────────────────────────────

model Issue {
  id          String        @id @default(uuid()) @db.Uuid
  locationId  String        @map("location_id") @db.Uuid
  reportId    String?       @map("report_id") @db.Uuid
  title       String
  description String?
  severity    IssueSeverity @default(sedang)
  status      IssueStatus   @default(terbuka)
  raisedById  String?       @map("raised_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  location Location         @relation(fields: [locationId], references: [id])
  report   DailyReport?     @relation(fields: [reportId], references: [id])
  actions  RecoveryAction[]

  @@index([locationId, status])
  @@map("issues")
}

model RecoveryAction {
  id          String         @id @default(uuid()) @db.Uuid
  issueId     String         @map("issue_id") @db.Uuid
  description String
  picUserId   String?        @map("pic_user_id") @db.Uuid
  picName     String?        @map("pic_name")
  dueDate     DateTime?      @map("due_date") @db.Date
  status      RecoveryStatus @default(direncanakan)
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  issue   Issue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  updates RecoveryUpdate[]

  @@index([issueId])
  @@map("recovery_actions")
}

model RecoveryUpdate {
  id          String   @id @default(uuid()) @db.Uuid
  actionId    String   @map("action_id") @db.Uuid
  note        String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

