enum PhotoMetadataSource {
  exif
  device
  filename
  server
  manual
}

/// Asal KOORDINAT yang tercap di foto. Dipisah dari waktu (PhotoMetadataSource)
/// karena keduanya bisa berbeda sumber. `project` = titik lokasi proyek dari
/// database — cadangan saat foto tidak membawa GPS; itu BUKAN posisi foto dan
/// tidak boleh dihitung sebagai bukti GPS (DECISIONS 197).
enum PhotoGpsSource {
  exif
  device
  project
  /// Diketik manusia saat perbaikan cap — bukan bacaan alat. Ditandai di cap
  /// dan TIDAK dihitung sebagai bukti GPS (DECISIONS 198).
  manual
  none
}

/// Master data jenis kegiatan lapangan — bisa dikelola admin di Sistem (tambah/
/// ubah/nonaktif). Menggantikan enum FieldActivityType supaya jenis kegiatan
