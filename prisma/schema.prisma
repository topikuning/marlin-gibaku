model Document {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  packageId    String?      @map("package_id") @db.Uuid
  contractId   String?      @map("contract_id") @db.Uuid
  locationId   String?      @map("location_id") @db.Uuid
  amendmentId  String?      @map("amendment_id") @db.Uuid
  milestoneId  String?      @map("milestone_id") @db.Uuid
  phase        AdminPhase
  type         DocumentType
  title        String
  docNumber    String?      @map("doc_number")
  docDate      DateTime?    @map("doc_date") @db.Date
  expiryDate   DateTime?    @map("expiry_date") @db.Date
  description  String?
  r2Key        String       @unique @map("r2_key")
  fileName     String       @map("file_name")
  mimeType     String       @map("mime_type")
  bytes        Int
  sha256       String
  supersedesId String?      @map("supersedes_id") @db.Uuid
  uploadedById String       @map("uploaded_by_id") @db.Uuid
  uploadedAt   DateTime     @default(now()) @map("uploaded_at") @db.Timestamptz

  /// Dokumen tidak dihapus diam-diam: yang salah unggah DIBATALKAN (hilang dari
  /// daftar, tidak lagi jadi bukti milestone) — file & jejak audit tetap ada.
  /// Hapus permanen hanya untuk super_admin, dan hanya setelah dibatalkan.
  status       DocumentStatus @default(aktif)
  voidedAt     DateTime?      @map("voided_at") @db.Timestamptz
  voidedById   String?        @map("voided_by_id") @db.Uuid
  voidReason   String?        @map("void_reason")

  /// Asal berkas. `drive_kkp` = ditarik dari folder Google Drive KKP; salinan
  /// isinya tetap disimpan di R2 supaya dokumen tidak ikut hilang bila KKP
  /// memindah/menghapus file di Drive.
  source          DocumentSource @default(unggahan)
  driveFileId     String?        @map("drive_file_id")
  driveWebLink    String?        @map("drive_web_link")
  drivePath       String?        @map("drive_path")
  driveModifiedAt DateTime?      @map("drive_modified_at") @db.Timestamptz

  organization Organization       @relation(fields: [orgId], references: [id])
  package      Package?           @relation(fields: [packageId], references: [id])
  contract     Contract?          @relation(fields: [contractId], references: [id])
  location     Location?          @relation(fields: [locationId], references: [id])
  amendment    ContractAmendment? @relation(fields: [amendmentId], references: [id])
  milestone    AdminMilestone?    @relation(fields: [milestoneId], references: [id])
  supersedes   Document?          @relation("docVersions", fields: [supersedesId], references: [id])
  versions     Document[]         @relation("docVersions")
  rabRevisions RabRevision[]      @relation("rabSourceDoc")
  expenses     Expense[]          @relation("expenseEvidence")

  @@unique([orgId, driveFileId], name: "documents_org_drive_file_key")
  @@index([packageId, phase])
  @@index([locationId, phase])
  @@index([orgId, sha256])
  @@index([orgId, status])
  @@index([type])
  @@map("documents")
}

