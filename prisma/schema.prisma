/// Setting effective-dated (mis. ppn_percent default)
model AppSetting {
  id            String   @id @default(uuid()) @db.Uuid
  key           String
  value         String
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([key, effectiveFrom])
  @@map("app_settings")
}

// ─────────────────────────────────────────────────────────────
// LAPORAN EKSEKUTIF → WA (rangkuman AI dikirim ke direksi)
// ─────────────────────────────────────────────────────────────

/// Kontak tujuan WA milik seorang user (per-pembuat). chatId = target WAHA:
/// grup "…@g.us", kontak "…@c.us", atau nomor polos. DECISIONS 122.
/// Relasi `owner` WAJIB ada (DECISIONS 150): tanpa itu kontak tidak bisa
/// disaring per organisasi — penyebab kebocoran lintas-tenant di direktori
/// pengenal pengirim.
model WaContact {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  chatId    String   @map("chat_id")
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner User @relation("WaContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("wa_contacts")
}

/// Histori kirim laporan eksekutif (audit + arsip teks yang dikirim). DECISIONS 122.
model ReportDispatch {
  id          String   @id @default(uuid()) @db.Uuid
  senderId    String   @map("sender_id") @db.Uuid
  reportKey   String   @map("report_key")
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  destName    String   @map("dest_name")
  destChatId  String   @map("dest_chat_id")
  provider    String? // provider AI yang menyusun (untuk jejak)
  text        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([senderId, createdAt])
  @@map("report_dispatches")
}

// ─────────────────────────────────────────────────────────────
// AI INTELLIGENCE HUB (DECISIONS 133)
// AI = penjelas, BUKAN sumber angka. Semua angka dari calc layer;
// run menyimpan snapshot sumber + output terstruktur tervalidasi.
// ─────────────────────────────────────────────────────────────

enum AiRunKind {
  pulse // Portfolio Pulse — ringkasan + prioritas lintas lokasi
  deviasi // Explain Variance — pisahkan data gap vs keterlambatan fisik
  risiko // Risk Intelligence — prioritisasi risiko
  kualitas_data // Audit Kualitas Data — penjelasan temuan rule
  laporan // Report Studio — draf laporan terstruktur
  tanya // Ask MARLIN — jawaban grounded
}

enum AiRunStatus {
  berjalan
  siap
  gagal
}

enum AiArtifactKind {
  laporan // draf laporan (Report Studio)
  saran // draft action/recovery usulan AI — TIDAK menulis domain
}

/// Lifecycle artefak laporan AI — terpisah dari DailyReport.
enum AiArtifactStatus {
  draft
  direview
  disetujui
  beku // immutable; siap distribusi
  terkirim
}

/// Satu eksekusi AI (satu panggilan provider per run). Usage inline (1 run = 1 call,
/// tabel terpisah tidak memberi nilai). sourcesJson = SourceRef[] utk drawer sumber.
model AiRun {
  id               String      @id @default(uuid()) @db.Uuid
  /// Nullable sejak DECISIONS 351: tanya-jawab GRUP WhatsApp dijawab tanpa
  /// pengirim terdaftar, jadi pemakaian AI-nya tidak punya pengguna. Jangan
  /// diisi pengguna karangan — audit yang menunjuk orang yang tidak melakukan
  /// apa-apa lebih buruk daripada kolom kosong.
  userId           String?     @map("user_id") @db.Uuid
  /// Organisasi pemilik pemakaian ini. Dipakai kuota harian organisasi —
  /// sebelumnya diturunkan lewat daftar id pengguna organisasi, yang tidak bisa
  /// menghitung run tanpa pengguna (dan melebar seiring jumlah akun).
  orgId            String?     @map("org_id") @db.Uuid
  /// Chat WhatsApp asal, bila run ini dipicu dari grup. Kunci pembatas laju
  /// untuk penanya yang tidak terdaftar (DECISIONS 351).
  waChatId         String?     @map("wa_chat_id")
  runKind          AiRunKind   @map("run_kind")
  status           AiRunStatus @default(berjalan)
  scopeType        String      @map("scope_type") // location | package | all
  scopeIds         Json        @map("scope_ids") // string[] locationId TERRESOLVE (sudah di-intersect izin)
  periodStart      DateTime    @map("period_start") @db.Date
  periodEnd        DateTime    @map("period_end") @db.Date
  provider         String?
  model            String?
  promptVersion    String?     @map("prompt_version")
  inputHash        String?     @map("input_hash")
  sourceSnapshotAt DateTime?   @map("source_snapshot_at") @db.Timestamptz
  readinessScore   Int?        @map("readiness_score")
  confidence       Int?
  sourcesJson      Json?       @map("sources_json")
  outputJson       Json?       @map("output_json")
  limitations      Json?
  inputTokens      Int?        @map("input_tokens")
  outputTokens     Int?        @map("output_tokens")
  latencyMs        Int?        @map("latency_ms")
  estimatedCostUsd Decimal?    @map("estimated_cost_usd") @db.Decimal(12, 6)
  errorCode        String?     @map("error_code")
  errorMessage     String?     @map("error_message")
  startedAt        DateTime    @default(now()) @map("started_at") @db.Timestamptz
  finishedAt       DateTime?   @map("finished_at") @db.Timestamptz
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz

  artifacts AiArtifact[]
  messages  AiMessage[]

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
  @@index([waChatId, createdAt])
  @@index([runKind, createdAt])
  @@index([status, createdAt])
  @@map("ai_runs")
}

/// Artefak hasil run: laporan (lifecycle review→approve→freeze→distribute) atau
/// saran (draft action non-eksekusi). Regenerate = version baru (baris baru).
model AiArtifact {
  id                String           @id @default(uuid()) @db.Uuid
  // Nullable: artefak "saran" bisa dibuat dari temuan deterministik TANPA run AI.
  runId             String?          @map("run_id") @db.Uuid
  kind              AiArtifactKind
  templateKey       String?          @map("template_key")
  templateVersion   Int              @default(1) @map("template_version")
  version           Int              @default(1)
  status            AiArtifactStatus @default(draft)
  title             String
  structuredContent Json             @map("structured_content")
  renderedText      String?          @map("rendered_text") @db.Text
  humanEditNote     String?          @map("human_edit_note")
  createdById       String           @map("created_by_id") @db.Uuid
  reviewedById      String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?        @map("reviewed_at") @db.Timestamptz
  approvedById      String?          @map("approved_by_id") @db.Uuid
  approvedAt        DateTime?        @map("approved_at") @db.Timestamptz
  frozenAt          DateTime?        @map("frozen_at") @db.Timestamptz
  contentHash       String?          @map("content_hash")
  distributions     Json? // {at, channel, target, byId, hash}[]
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  run AiRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([kind, status])
  @@index([status, updatedAt])
  @@map("ai_artifacts")
}

/// Percakapan Ask MARLIN (scope + periode terkunci saat dibuat).
model AiConversation {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String?
  scopeIds    Json     @map("scope_ids") // string[] locationId terresolve
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  messages AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String // "user" | "asisten"
  content        String   @db.Text
  citations      Json? // SourceRef[] ringkas
  confidence     Int?
  runId          String?  @map("run_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run          AiRun?         @relation(fields: [runId], references: [id])

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// Lifecycle ringkasan chat grup — draf AI wajib direview manusia sebelum
/// difinalkan & dikirim. DECISIONS 139.
enum WaChatSummaryStatus {
  draft_ai
  edited_draft
  final
  sent
}

/// Ringkasan AI harian percakapan grup WA per paket (Layer B, DECISIONS 135).
/// Satu baris per (paket, tanggal Jakarta); regenerate menimpa (upsert).
model WaChatSummary {
  id            String              @id @default(uuid()) @db.Uuid
  packageId     String              @map("package_id") @db.Uuid
  summaryDate   DateTime            @map("summary_date") @db.Date
  messageCount  Int                 @map("message_count")
  summaryText   String              @map("summary_text") @db.Text
  provider      String?
  model         String?
  createdById   String?             @map("created_by_id") @db.Uuid
  // Lifecycle + jejak penyusunan (DECISIONS 139). Draf AI TIDAK PERNAH otomatis
  // final — harus dilewatkan review manusia sebelum dikirim ke pimpinan.
  status        WaChatSummaryStatus @default(draft_ai)
  version       Int                 @default(1)
  aiText        String?             @map("ai_text") @db.Text // draf AI asli (pembanding editan manusia)
  confidence    Int?
  marlinCount   Int                 @default(0) @map("marlin_count")
  excludedCount Int                 @default(0) @map("excluded_count")
  generatedById String?             @map("generated_by_id") @db.Uuid
  generatedAt   DateTime?           @map("generated_at") @db.Timestamptz
  editedById    String?             @map("edited_by_id") @db.Uuid
  editedAt      DateTime?           @map("edited_at") @db.Timestamptz
  finalizedById String?             @map("finalized_by_id") @db.Uuid
  finalizedAt   DateTime?           @map("finalized_at") @db.Timestamptz
  lastSentAt    DateTime?           @map("last_sent_at") @db.Timestamptz
  dispatches    Json? // {at, target, chatId, byId}[]
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, summaryDate])
  @@index([summaryDate])
  @@map("wa_chat_summaries")
}

/// Alias pengirim WhatsApp — memberi NAMA pada pengirim yang hanya dikenal
/// sebagai nomor/LID, supaya ringkasan ke pimpinan menyebut orang, bukan kode.
/// Kunci = JID mentah (…@c.us / …@lid) atau nomor polos. DECISIONS 138.
/// Berbeda dari WaContact: alias adalah jawaban atas "nomor ini siapa" —
/// faktanya sama untuk semua orang, jadi sengaja DIPAKAI BERSAMA se-organisasi
/// (DECISIONS 150). Dikelola di halaman Manajemen Kontak.
model WaSenderAlias {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  senderKey   String   @map("sender_key")
  displayName String   @map("display_name")
  role        String?
  note        String?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("WaSenderAliasCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([orgId, senderKey])
  @@index([orgId])
  @@map("wa_sender_aliases")
}

/// Catatan pengiriman pengingat laporan harian per orang per hari — SATU baris
/// per (user, tanggal). Unique-nya yang membuat penjadwal aman dijalankan
/// berkali-kali: percobaan kedua di hari yang sama akan menabrak, bukan
/// mengirim pesan dobel ke lapangan. DECISIONS 202.
model DailyReminderLog {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// Tanggal kerja Asia/Jakarta (YYYY-MM-DD).
  dateKey     String    @map("date_key")
  /// Jumlah lokasi yang ditagih pada pesan itu.
  locations   Int
  /// sukses | gagal
  status      String
  error       String?
  /// ID pesan dari WAHA. Ini SATU-SATUNYA bukti bahwa pesannya benar-benar
  /// diterima antrean WhatsApp; tanpa ini "sukses" hanya berarti "server
  /// menjawab 2xx", yang bisa terjadi walau tidak ada pesan yang keluar
  /// (DECISIONS 206).
  waMessageId String?   @map("wa_message_id")
  /// Tujuan yang BENAR-BENAR dipakai saat mengirim (628…@c.us). Disimpan supaya
  /// "terkirim tapi tidak sampai" bisa ditelusuri ke nomornya, bukan ditebak.
  chatId      String?   @map("chat_id")
  /// Berapa kali pengingat hari itu dikirim. Cron mengirim sekali; admin boleh
  /// mengulang sebanyak yang ia mau (DECISIONS 207).
  attempts    Int       @default(1)
  lastSentAt  DateTime? @map("last_sent_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, dateKey])
  @@index([dateKey])
  @@map("daily_reminder_logs")
}

/// Jejak kirim LAPORAN PROGRES MINGGUAN ke grup WhatsApp paket (DECISIONS 311).
///
/// Kuncinya `(packageId, weekNumber)`, bukan tanggal: yang dilaporkan adalah
/// MINGGU KONTRAK, dan minggu itu hanya boleh diumumkan sekali. Cron berjalan
/// setiap hari dan aman dipicu berulang — pengamannya di sini, bukan pada
/// ketepatan jadwal penjadwal luar.
///
/// Baris ber-status `gagal` SENGAJA tidak menghalangi percobaan berikutnya:
/// yang tidak boleh berulang adalah pesan yang BENAR-BENAR sampai, bukan
/// percobaan yang kandas karena WAHA sedang mati.
model WeeklyWaLog {
  id          String    @id @default(uuid()) @db.Uuid
  packageId   String    @map("package_id") @db.Uuid
  package     Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  /// Minggu kontrak ke berapa sejak SPMK — sifat kontrak, sama untuk semua lokasinya.
  weekNumber  Int       @map("week_number")
  /// Jumlah desa/KNMP yang ikut di pesan itu.
  locations   Int
  /// sukses | gagal
  status      String
  error       String?
  /// ID pesan dari WAHA — satu-satunya bukti pesannya masuk antrean WhatsApp
  /// (alasan lengkap: DECISIONS 206).
  waMessageId String?   @map("wa_message_id")
  /// Grup yang BENAR-BENAR dituju saat mengirim (…@g.us).
  chatId      String?   @map("chat_id")
  /// true = ditekan orang lewat tombol, false = dikirim penjadwal.
  manual      Boolean   @default(false)
  /// Teks yang dikirim, apa adanya. Laporan resmi ke pemberi kerja harus bisa
  /// dibuktikan isinya belakangan, bukan disusun ulang dari angka hari ini —
  /// angka hari ini sudah berubah.
  body        String
  sentById    String?   @map("sent_by_id") @db.Uuid
  attempts    Int       @default(1)
  lastSentAt  DateTime? @map("last_sent_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([packageId, weekNumber])
  @@index([createdAt])
  @@map("weekly_wa_logs")
}

// ─────────────────────────────────────────────────────────────
// IZIN PERANGKAT (GPS & kamera) — DECISIONS 219
// ─────────────────────────────────────────────────────────────

/// Catatan APPEND-ONLY keadaan izin browser milik seorang user di satu
/// perangkat. Sengaja log, bukan satu kolom di `User`: izin browser melekat ke
/// PERANGKAT + situs, bisa dicabut kapan saja, dan seorang mandor lazim
/// berganti HP. Satu kolom "sudah izin" akan berbohong begitu izinnya dicabut
/// atau ia pindah perangkat.
model DevicePermission {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// "geolocation" | "camera"
  kind       String
  /// "granted" | "denied" | "prompt" | "unsupported"
  state      String
  userAgent  String?  @map("user_agent")
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, recordedAt])
  @@map("device_permissions")
}

/// PADANAN item RAB → analisa AHSP (DECISIONS 319).
///
/// Kuncinya `tanda` = tanda tangan teks uraian + satuan yang sudah dinormalkan,
/// dan itu GLOBAL, bukan per lokasi. Alasannya: AHSP adalah analisa NASIONAL —
/// "Pekerjaan Urugan Sirtu t = 10 cm" menganalisa pekerjaan yang sama entah di
/// Demak atau di Sumenep; yang berbeda per lokasi adalah HARGA satuan dasarnya,
/// bukan komposisi pekerjaannya. Karena 83 lokasi KNMP memakai templat RAB yang
/// sebagian besar sama, satu koreksi manusia di sini langsung membetulkan semua
/// lokasi yang uraiannya persis sama — itu yang diminta ("sistem memetakan
/// otomatis dan perbaiki yang salah").
///
/// `tanda` sengaja dibangun dari teks apa adanya (huruf + angka), BUKAN dari
/// token pencocokan: token membuang satuan ukur, sehingga "t = 10 cm" dan
/// "t = 10 mm" akan bertabrakan jadi satu padanan. Ketebalan 10 cm dan 10 mm
/// bukan variasi penulisan.
///
/// Keadaan yang bisa terjadi:
///   - baris TIDAK ADA          → belum pernah diperiksa
///   - entryId terisi           → punya padanan (otomatis atau hasil koreksi)
///   - entryId null + koreksi   → manusia MENYATAKAN tidak ada padanannya
/// Mesin tidak pernah menulis baris "tidak ada padanan": kalau ia ragu, ia
/// diam, supaya barisnya tetap terlihat sebagai lubang yang bisa dikerjakan.
model AhspPadanan {
  id           String   @id @default(uuid()) @db.Uuid
  tanda        String   @unique
  /// Uraian RAB apa adanya (contoh pertama yang terlihat) — untuk ditampilkan.
  uraianContoh String   @map("uraian_contoh")
  satuan       String
  entryId      String?  @map("entry_id") @db.Uuid
  /// true = manusia MENYATAKAN pekerjaan ini memang tak punya analisa AHSP.
  ///
  /// Disimpan POSITIF, tidak disimpulkan dari `entryId` yang kosong. Dulu
  /// disimpulkan, dan akibatnya fatal: sekali basis AHSP diimpor ulang, seluruh
  /// tautan putus (`ON DELETE SET NULL`) dan 1.086 padanan yang sudah disetujui
  /// berubah jadi "dinyatakan tidak ada" — keputusan yang tidak pernah diambil
  /// siapa pun, dan barisnya hilang dari daftar pekerjaan. DECISIONS 323.
  tidakAda     Boolean  @default(false) @map("tidak_ada")
  /// otomatis | disetujui | koreksi
  metode       String
  /// Skor mesin saat dipetakan otomatis (0..1). null untuk koreksi manusia.
  skor         Decimal? @db.Decimal(5, 4)
  /// true = mesin unggul cukup jauh dari kandidat kedua.
  meyakinkan   Boolean  @default(false)
  catatan      String?
  decidedById  String?  @map("decided_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  entry     AhspEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  decidedBy User?      @relation("AhspPadananDecider", fields: [decidedById], references: [id])

  @@index([entryId])
  @@index([metode])
  @@map("ahsp_padanan")
}

/// HARGA SATUAN DASAR (HSD) per lokasi — DECISIONS 327.
///
/// Kunci `(locationId, kategori, nama, satuan)` sengaja SAMA PERSIS dengan kunci
/// pengelompokan kebutuhan di `rapl-calc.ts`. Harga yang tidak bisa dijodohkan
/// dengan barisnya sendiri tidak ada gunanya, dan menjodohkan lewat nama yang
/// "mirip" adalah cara paling cepat memasang harga semen pada besi.
///
/// PER LOKASI, bukan per paket atau nasional: harga pasir di Demak dan di
/// Sumenep memang berbeda, dan itu justru yang membuat RAPL berguna. Harga dari
/// lokasi lain hanya ditawarkan sebagai REKOMENDASI yang harus dipilih orang —
/// tidak pernah dipakai diam-diam.
model HargaSatuanDasar {
  id         String   @id @default(uuid()) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  /// upah | bahan | alat | fasilitas — apa adanya dari komponen AHSP.
  kategori   String
  /// Nama sumber daya PERSIS seperti pada komponen AHSP.
  nama       String
  satuan     String
  /// Rupiah per satuan. BigInt seperti seluruh uang di sistem ini.
  harga      BigInt
  /// Dari mana harganya: survei toko, penawaran suplier, kontrak sebelumnya.
  /// Bukan hiasan — harga tanpa asal tidak bisa dipertahankan saat diperiksa.
  sumber     String?
  catatan    String?
  updatedById String? @map("updated_by_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation("HsdUpdater", fields: [updatedById], references: [id])

  @@unique([locationId, kategori, nama, satuan])
  @@index([locationId])
  @@index([kategori, nama, satuan])
  @@map("harga_satuan_dasar")
}
