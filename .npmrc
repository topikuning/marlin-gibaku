# Ketahanan unduhan paket (dipakai pnpm, lokal & CI).
#
# Job "Integration tests" gagal 29 Juli 2026 bukan karena kode: registry npm
# lambat, unduhan tarball (@prisma/client, next, esbuild, sharp) melewati batas
# waktu bawaan 60 detik, dua percobaan bawaan habis, install berhenti sebelum
# satu pun test jalan. Angka di bawah memperlebar toleransi itu — bukan
# menyembunyikan kegagalan: paket yang benar-benar tidak ada tetap gagal.
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
